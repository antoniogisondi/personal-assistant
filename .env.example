# Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit .env. Production uses real
# environment variables / a secret manager.

POSTGRES_PASSWORD=change-me-dev-only

GSOI_ENV=dev
GSOI_DATABASE_URL=postgresql+asyncpg://gsoi:change-me-dev-only@localhost:5432/gsoi
# Bearer token required by /v1/*. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GSOI_API_TOKEN=
GSOI_DEFAULT_PROFILE=reasoning
# GSOI_API_HOST=127.0.0.1

# Model profiles. Model ids are placeholders: set the real ones from your provider's docs.
GSOI_PROFILES__REASONING__PROVIDER=deepseek
GSOI_PROFILES__REASONING__MODEL=<cloud-model-id>
GSOI_PROFILES__REASONING__BASE_URL=https://api.deepseek.com/v1
GSOI_PROFILES__REASONING__API_KEY_REF=DEEPSEEK_API_KEY
GSOI_PROFILES__REASONING__INPUT_COST_PER_MTOK=0
GSOI_PROFILES__REASONING__OUTPUT_COST_PER_MTOK=0
GSOI_PROFILES__REASONING__FALLBACK=private

GSOI_PROFILES__PRIVATE__PROVIDER=ollama
GSOI_PROFILES__PRIVATE__MODEL=<local-model-id>
GSOI_PROFILES__PRIVATE__BASE_URL=http://localhost:11434/v1
GSOI_PROFILES__PRIVATE__IS_LOCAL=true

# The secret named by API_KEY_REF above (dev only; use a secret manager elsewhere):
DEEPSEEK_API_KEY=
